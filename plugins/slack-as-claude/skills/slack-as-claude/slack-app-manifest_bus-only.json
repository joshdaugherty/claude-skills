{
  "display_information": {
    "name": "Claude Code Bus",
    "description": "Lets concurrent Claude sessions post and read a Slack channel as an app"
  },
  "features": {
    "bot_user": {
      "display_name": "Claude Code Bus",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "channels:history",
        "groups:history"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "is_hosted": false,
    "token_rotation_enabled": false
  }
}
